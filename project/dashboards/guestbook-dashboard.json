{
  "uid": "guestbook-monitoring",
  "title": "Guestbook Overview",
  "tags": ["guestbook", "pulumi", "sre"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Request Rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(guestbook_http_requests_total{namespace=\"__APP_NAMESPACE__\"}[5m]))",
          "legendFormat": "requests/sec"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error Rate",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(guestbook_http_request_errors_total{namespace=\"__APP_NAMESPACE__\"}[5m]))",
          "legendFormat": "errors/sec"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Frontend Latency p95",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(guestbook_http_request_duration_seconds_bucket{namespace=\"__APP_NAMESPACE__\"}[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Pod CPU Usage",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"__APP_NAMESPACE__\", container!=\"\"}[5m])) by (pod)",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Pod Memory Working Set",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=\"__APP_NAMESPACE__\", container!=\"\"}) by (pod)",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Container Restarts",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum(kube_pod_container_status_restarts_total{namespace=\"__APP_NAMESPACE__\"}) by (pod)",
          "legendFormat": "{{pod}}"
        }
      ]
    }
  ]
}
